<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../common/schema/DHQauthor-TEI.rng"    type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0" ?>
<?xml-model href="../../common/schema/DHQauthor-TEI.isosch" type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<?xml-model href="../../common/schema/dhqTEI-ready.sch"     type="application/xml" schematypens="http://purl.oclc.org/dsdl/schematron"?>
<TEI xmlns=      "http://www.tei-c.org/ns/1.0"
     xmlns:cc=   "http://web.resource.org/cc/"
     xmlns:dhq=  "http://www.digitalhumanities.org/ns/dhq"
     xmlns:html= "http://www.w3.org/1999/xhtml"
     xmlns:mml=  "http://www.w3.org/1998/Math/MathML"
     xmlns:rdf=  "http://www.w3.org/1999/02/22-rdf-syntax-ns#">
  <!--
      Note: “language code” is typically one of:
        ak  — for Akan
        am  — for Amharic
        grc — for Ancient Greek (–1453)
        xzp — for Ancient Zapotec
        ar  — for Arabic
        bm  — for Bambara
        es  — for Castilian or Spanish
        ca  — for Catalan or Valencian
        zh  — for Chinese
        nl  — for Dutch or Flemish
        en  — for English
        fi  — for Finnish
        fir — for Firan
        nl  — for Flemish or Dutch
        fr  — for French
        de  — for German
        haw — for Hawaiian
        iw  — for Hebrew
        in  — for Indonesian
        it  — for Italian
        ja  — for Japanese
        ko  — for Korean
        la  — for Latin
        mnk — for Mandinka
        myn — for Mayan languages
        el  — for Modern Greek (1453–)
        nap — for Neapolitan
        fa  — for Persian
        crk — for Plains Cree
        pt  — for Portuguese
        ru  — for Russian
        sa  — for Sanskrit
        sn  — for Shona
        snk — for Soninke
        es  — for Spanish or Castilian
        sw  — for Swahili (macrolanguage)
        sv  — for Swedish
        tr  — for Turkish
        ca  — for Valencian or Catalan
        yi  — for Yiddish
  -->
  <teiHeader>
    <fileDesc>
      <titleStmt>
        <title type="article" xml:lang="[language code]"><!-- article title in non-English language--></title>
        <title type="article" xml:lang="en"><!-- article title in English --></title>
        <dhq:authorInfo xml:id="">
          <!-- Include a separate <dhq:authorInfo> element for each author.
               The value of xml:id should be first_last without diacritics, all lower case.
          -->
          <dhq:author_name>first name(s) <dhq:family>family name</dhq:family></dhq:author_name>
          <idno type="ORCID"><!-- if the author has an ORCID ID, include the full URI, e.g. https://orcid.org/0000-0000-0000-0000 --></idno>
          <dhq:affiliation/>
          <email/>
          <dhq:bio><p/></dhq:bio>
        </dhq:authorInfo>
        <dhq:translatorInfo xml:id="">
          <!-- Include a separate <dhq:translatorInfo> element for each translator 
               The value of xml:id should be first_last without diacritics, all lower case.
          -->
          <dhq:translator_name>first name(s) <dhq:family>family name</dhq:family></dhq:translator_name>
          <dhq:affiliation/>
          <email/>
          <dhq:bio><p/></dhq:bio>
        </dhq:translatorInfo>
        <respStmt xml:id="AI_trans_info_[language code]"> <!-- use code of the target language into which AI translated-->
          <name>
            <ref target="[URL of AI system]"><!-- name of AI system used to assist in translation, including version #, if available --></ref>
          </name>
          <resp>Initial translation into [language name]</resp>
          <note type="boilerplate">Artificial intelligence systems, including machine translation systems, are not considered by DHQ to be authors and hence are not accorded authorial agency. See DHQ's <ref target="../../submissions/ai_policies.html">AI policy page</ref> for more information.</note>
          <note type="process"><!-- author-generated free-form annotation here --></note>
        </respStmt>
      </titleStmt>
      <publicationStmt>
        <publisher>Alliance of Digital Humanities Organizations</publisher>
        <publisher>Association for Computers and the Humanities</publisher>

        <!-- This information should be added when the XML file is created: -->            
        <idno type="DHQarticle-id"><!-- including leading zeroes: e.g. 000110 --></idno>
        <!-- This information will be completed at publication: -->            
        <idno type="DOI"><!-- e.g., “10.63744/4r3z3t7zbx5u”; i.e. without any prefix such as “doi:” or “https://” --></idno>
        <idno type="volume"><!-- volume number, with leading zeroes: e.g. 006 --></idno>
        <idno type="issue"><!-- issue number, without leading zeroes: e.g. 2 --></idno>
        
        <date when=""><!-- date: e.g. 22 July 2010 --></date>
        <dhq:articleType/>
        <availability status="CC-BY-ND">
          <!--         If using a different license from the default, choose one of the following:
               CC-BY-ND (DHQ default): <cc:License rdf:about="http://creativecommons.org/licenses/by-nd/2.5/"/>     
               CC-BY:  <cc:License rdf:about="https://creativecommons.org/licenses/by/2.5/"/>
               CC0: <cc:License rdf:about="https://creativecommons.org/publicdomain/zero/1.0/"/>
          -->                    
          <cc:License rdf:about="https://creativecommons.org/licenses/by-nd/2.5/"/>
        </availability>
      </publicationStmt>

      <sourceDesc>
        <p>This is the source</p>
      </sourceDesc>
    </fileDesc>
    <encodingDesc>
      <classDecl>
        <taxonomy xml:id="dhq_keywords">
          <bibl>DHQ classification scheme; full list available at <ref target="https://dhq.digitalhumanities.org/taxonomy.xml">https://dhq.digitalhumanities.org/taxonomy.xml</ref></bibl>
        </taxonomy>
        <taxonomy xml:id="authorial_keywords">
          <bibl>Keywords supplied by author; no controlled vocabulary</bibl>
        </taxonomy>
      </classDecl>
    </encodingDesc>
    <profileDesc>

      <langUsage>
        <language ident="en" extent="fill in extent: default | alternate | abstract_only "/>
        <language ident="[language code]" extent=" fill in extent "/>
      </langUsage>
      <textClass>
        <keywords scheme="#dhq_keywords">
          <list>
            <!-- fill in a separate <item> for each keyword or keyword phrase -->
            <item/>
          </list>
        </keywords>
        <keywords scheme="#authorial_keywords">
          <term/>
        </keywords>
      </textClass>
    </profileDesc>
    <revisionDesc>
      <!-- Replace "NNNNNN" in the @target of ref below with the appropriate DHQarticle-id value. -->
      <change>The version history for this file can be found on <ref type="gitHist" target="https://github.com/Digital-Humanities-Quarterly/dhq-journal/commits/main/articles/NNNNNN/NNNNNN.xml">GitHub</ref>.</change>
      <!-- Each change should include @who and @when as well as a brief note on what was done. -->
      <change/>
    </revisionDesc>
  </teiHeader>

  <text>
    <group>

      <!-- *** in default language *** -->
      
      <text xml:lang="[language code]" type="default" resp="-- fill in --">
        <!-- @resp points to one of:
             1) a <dhq:authorInfo> if not translated by someone or something else
             2) a <dhq:translatorInfo> if translated by a human
             3) a <respStmt> if translated by machine (not common for "default") -->
        <front>
          <dhq:abstract>
            <p/>
          </dhq:abstract>
          <dhq:teaser>
            <p/>
          </dhq:teaser>
        </front>
        <body>
          <head> </head>
          <div>
            <head/>
            <p/>
          </div>
        </body>
      </text>

      <!-- *** only an abstract in alternate language *** -->

      <text xml:lang="[language code]" type="abstract_only" resp="!-- fill in --">
        <!-- @resp points to one of:
             1) a <dhq:authorInfo> if not translated by someone or something else
             2) a <dhq:translatorInfo> if translated by a human
             3) a <respStmt> if translated by machine (most common for "abstract_only") -->
        <front>
          <dhq:abstract>
            <p/>
          </dhq:abstract>
          <dhq:teaser>
            <p/>
          </dhq:teaser>
        </front>
        <body>
          <head>Note on Translation</head>
          <div>
            <!-- This boilerplate paragraph describes DHQ’s translation practices. -->
            <p>For articles in languages other than English, DHQ
            provides an English-language abstract to support searching
            and discovery, and to enable those not fluent in the
            article's original language to get a basic understanding
            of its contents. In many cases, machine translation may be
            helpful for those seeking more detailed access. While DHQ
            does not typically have the resources to translate
            articles in full, we welcome contributions of effort from
            readers. If you are interested in translating any article
            into another language, please contact us at
            editors@digitalhumanities.org and we will be happy to work
            with you.</p>
          </div>
        </body>
      </text>
      
      <!-- *** entire article in alternate language *** -->

      <text xml:lang="[language code]" type="alternate" resp="!-- fill in --">
        <!-- @resp points to one of:
             1) a <dhq:authorInfo> if not translated by someone or something else
             2) a <dhq:translatorInfo> if translated by a human
             3) a <respStmt> if translated by machine (even if a human cleans up after the auto-translation) -->
        <front>
          <dhq:abstract>
            <p/>
          </dhq:abstract>
          <dhq:teaser>
            <p/>
          </dhq:teaser>
        </front>
        <body>
          <head> </head>
          <div>
            <head/>
            <p/>
          </div>
        </body>
      </text>
            
    </group>

    <back>
      <listBibl>
        <!-- The bibliography should follow DHQ's standard practices. -->
        <bibl key="" xml:id="flanders1999" label="Flanders 1999">Flanders, Julia. <title rend="quotes">Scholarly Habits and Digital Resources: Observations from a User
        Survey</title>. Women Writers Project, 1999. <ref target="http://www.wwp.brown.edu/about/rwo/rwo_initial_report.html">http://www.wwp.brown.edu/about/rwo/rwo_initial_report.html</ref>.</bibl>
        <bibl xml:id="liu2004" label="Liu 2004">Liu, Alan. <title rend="quotes">Transcendental
        Data: Toward A Cultural History and Aesthetics of the New Encoded
        Discourse.</title>
        <title rend="italic">Critical Inquiry</title> 31 (2004): 49-84.</bibl>
        <bibl xml:id="liu2003" label="Liu 2003">Liu, Alan. <title rend="quotes">The Humanities:
        A Technical Profession.</title> Panel on <title rend="quotes">Information
        Technology and the Profession.</title> Modern Language Association Convention. San
        Diego. 18 December 2003. <ref target="http://www.english.ucsb.edu/faculty/ayliu/research/talks/2003MLA/Liu_Talk.pdf">http://www.english.ucsb.edu/faculty/ayliu/research/talks/2003MLA/Liu_Talk.pdf</ref>.</bibl>
        <bibl xml:id="test1001" label="Test 1001"><name role="editor"/></bibl>
        <bibl xml:id="test1001" label="Test 1001"><name role="editor"/></bibl>
      </listBibl>

    </back>
  </text>
</TEI>
